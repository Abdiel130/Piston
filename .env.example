# ==============================================================================
# Piston Environment Configuration
# ==============================================================================

# Project Name
COMPOSE_PROJECT_NAME=piston

# Host Exposed Ports (Collision-free defaults)
APP_PORT=4300
SERVER_PORT=8088
DB_PORT=5438

# Database Settings (PostgreSQL 18)
DB_CONNECTION=pgsql
DB_HOST=piston-db
DB_PORT_INTERNAL=5432
DB_DATABASE=piston
DB_USERNAME=piston_user
DB_PASSWORD=piston_secret_password

# Application Settings
APP_NAME=Piston
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8088
FRONTEND_URL=http://localhost:4300
